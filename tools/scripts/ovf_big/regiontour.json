[
 {
  "goto": "http://localhost:4174"
 },
 {
  "until": "window.__services && window.__services.save",
  "timeout": 20000
 },
 {
  "eval": "__services.save.data.settings.textScale=1.3; __services.save.markDirty(); __services.save.flush(); setTimeout(()=>location.reload(),50); 'r'"
 },
 {
  "wait": 1500
 },
 {
  "until": "window.__overflow && window.__game && window.__game.scene.getScenes(true).length > 0",
  "timeout": 30000
 },
 {
  "until": "window.__game && window.__services && window.__services.save && ['Menu','Onboarding'].some(k=>__game.scene.isActive(k))",
  "timeout": 30000
 },
 {
  "eval": "localStorage.clear(); __services.save.reset(); __services.notify=()=>{}; const s=__services.save.data; s.profile.onboardingDone=true; s.profile.introSeen=true; s.profile.tutorialDone=true; const g=__game; g.scene.getScenes(true).filter(x=>x.scene.key!=='Notify').forEach(sc=>sc.scene.stop()); const run=__run.start({heroId:'rowan'}); run.regions={'2':'drowned'}; while(run.depth<2) __run.advance(run); run.level=10; g.scene.start('RunMap'); 'r'"
 },
 {
  "until": "__game.scene.isActive('RunMap') && __game.scene.getScene('RunMap').cameras && __game.scene.getScene('RunMap').cameras.main",
  "timeout": 10000
 },
